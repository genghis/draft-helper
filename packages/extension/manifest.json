{
  "manifest_version": 3,
  "name": "Draft Helper Sync",
  "version": "0.1.1",
  "description": "Mirrors your online fantasy football draft picks onto your Draft Helper board, live, as they happen.",
  "permissions": ["storage"],
  "host_permissions": ["https://draft.clanseafox.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/football/draft*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://fantasy.espn.com/football/draft*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Draft Helper Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
